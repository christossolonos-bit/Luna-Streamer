# Display names — used for chat UI labels only — must match bot persona names for reply routing
VITE_LUNA_NAME=Luna
VITE_HIMARI_NAME=Himari
VITE_VIKTOR_NAME=Viktor

# YouTube — videos work without Luna running on your PC
VITE_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@lunawolfsolo
VITE_YOUTUBE_CHANNEL_HANDLE=@lunawolfsolo
VITE_YOUTUBE_CHANNEL_TITLE=Luna wolf
# Optional: comma-separated video IDs to embed on the site (11 chars each)
# VITE_YOUTUBE_VIDEO_IDS=dQw4w9WgXcQ,abc123xyz01

# GitHub Pages project site: /Luna-Streamer/ (set in CI; leave / for local dev)
# VITE_BASE_PATH=/Luna-Streamer/
