# Copy to viewer/.env. Overridden by the ?chat_ws=… query param when main.py
# launches the viewer, so this is only used if you open the viewer directly.
# Must match the port from twitch_bot's chat-bridge WebSocket (default 8765).
VITE_CHAT_WS_URL=ws://127.0.0.1:8765/ws

# Screen share → Luna (while sharing in the viewer dock)
# Screen JPEG upload interval (ms). Match LUNA_SCREEN_CONTEXT_INTERVAL_SEC on the bot.
VITE_SCREEN_CONTEXT_INTERVAL_MS=1000
# Cap Three.js DPR (1 = lighter GPU; default 1.5)
# VITE_RENDERER_MAX_DPR=1
VITE_SCREEN_CAPTURE_MAX_WIDTH=1280
VITE_SCREEN_CAPTURE_JPEG_QUALITY=0.72
