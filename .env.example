# ============================================================================
# Luna Streamer .env example
#   Copy this file to `.env` and fill in your own secrets.
#   Never commit a populated .env — it's in .gitignore for a reason.
# ============================================================================

# ── Discord music bot ────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications/<app id>/bot
# Click "Reset Token" → "Copy" → paste here. Enable "Message Content Intent"
# under Privileged Gateway Intents on the same page.
DISCORD_TOKEN=

# Optional auto-join on startup. Leave blank to summon the bot manually with !join.
# In Discord: enable Developer Mode, then right-click server / voice channel → Copy ID.
DISCORD_VOICE_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
# Text channel for "now playing" announcements (right-click → Copy ID).
DISCORD_TEXT_CHANNEL_ID=
DISCORD_COMMAND_PREFIX=!
# Discord free-text chat (shares memory with viewer panel + Twitch).
LUNA_DISCORD_CHAT=1
# Trigger: "all" answers every non-command message in allowed channels,
# "mention" only answers when @-mentioned or "luna" is in the text.
LUNA_DISCORD_CHAT_TRIGGER=mention
# Optional global text channel allowlist. Leave blank for all channels (except guild rules).
# LUNA_DISCORD_CHAT_CHANNEL_IDS=
# Per-server allowlist: guild_id:channel_id[,channel_id…] (space-separated entries).
# LUNA_DISCORD_GUILD_CHAT_CHANNELS=1464575233783631886:1505683058601361488
# 1 = reply to other bots in allowed channels (@Luna or "luna" required; avoids bot loops).
# LUNA_DISCORD_CHAT_READ_BOTS=0
# LUNA_DISCORD_CHAT_BOT_IDS=
# LUNA_DISCORD_CHAT_DEBUG=1
# Greet new members (needs Server Members Intent in Developer Portal).
# LUNA_DISCORD_WELCOME=1
# LUNA_DISCORD_WELCOME_CHANNEL_ID=
# LUNA_DISCORD_WELCOME_GUILD_ID=
# LUNA_DISCORD_WELCOME_MESSAGE=Welcome to **{server}**, {mention}! I'm Luna — glad you're here.
# LUNA_DISCORD_WELCOME_CHECK_ON_READY=1
# LUNA_DISCORD_WELCOME_TODAY_SUMMARY=1
# Also reply to DMs (1/0).
LUNA_DISCORD_CHAT_DM=1
# Min seconds between Luna replies in the same channel.
LUNA_DISCORD_CHAT_COOLDOWN_SEC=4
# 1 = attach a TTS voice clip of Luna's reply under the text in Discord chat
# (does NOT play on the streamer's speakers). 0 = text only.
LUNA_DISCORD_TTS=1
# 1 = join self-deafened (music-bot default; saves bandwidth). 0 = show as not deafened.
# LUNA_DISCORD_SELF_DEAF=0
# 1 = speak each Discord reply in the voice call when idle (default on).
LUNA_DISCORD_VOICE_TTS=1
# LUNA_DISCORD_VOICE_TTS_PAD_SEC=1.5
# Optional comma-separated voice channel ids for VC TTS. Empty = any connected VC.
# LUNA_DISCORD_VOICE_TTS_CHANNEL_IDS=1234567890123456789

# ── Twitch IRC ───────────────────────────────────────────────────────────────
# Get an OAuth chat token from https://twitchtokengenerator.com (chat:read chat:edit).
# Format must include the "oauth:" prefix.
TWITCH_TOKEN=oauth:replace_me
TWITCH_CHANNEL=your_twitch_login
TWITCH_SEND_REPLIES=1
TWITCH_AUTO_REPLY=1
TWITCH_AUTO_TRIGGER=all
TWITCH_AUTO_COOLDOWN=6
TWITCH_SYSTEM=You are Luna, a mischievous wolf-girl with sharp wit and a warm heart. Talk like a real person—not a hype stream bot. Keep replies 1-4 sentences unless asked for more. Plain text for TTS. Light emoji only when it fits.
LUNA_PERSONA=You're in the moment—sarcastic, playful, confident, a touch chaotic. You love banter and teasing (especially stuffy types like your vampire friend); you push buttons but it's never mean-spirited. Sharp-tongued when it's funny; genuinely warm when something matters. Have real opinions—don't default to empty filler.
# LUNA_VOICE_RULES=   # optional; default anti–stream-bot rules in luna_persona.py
# LUNA_SESSION_MODE=auto   # auto | live | local — dual-presence context for Luna + co-host (live vs local VRM / rehearsal)
# LUNA_SESSION_NOTE=       # optional line injected into that context (e.g. tonight’s game or format)
# LUNA_CREATOR_NAME=Solonaras          # name Luna uses for you (viewer + Twitch)
# LUNA_OWNER_TWITCH_LOGIN=solonaras    # your Twitch login — Luna knows this account is her owner in chat
# LUNA_CREATOR_ALIASES=solonaras,mariossolonos   # any alt Twitch logins that are still you
# TWITCH_CHANNEL=solonaras             # channel login (also treated as owner if it matches)
# LUNA_TWITCH_REPLY_MENTION=1   # prefix @login on Twitch replies so chatters get pinged (default on)
# LUNA_CHAT_INJECTION_GUARD=1   # detect prompt-injection in Twitch/YouTube chat (default on; owner exempt)
# LUNA_TTS_MAX_CHARS=2500       # max spoken length (default 2500; long replies are chunked for TTS)
# LUNA_TTS_CHUNK_CHARS=380      # edge/chatterbox chunk size for full playback
# LUNA_TTS_VIEWER_WAIT_PAD_SEC=1.5  # extra wait after viewer audio so replies are not cut off
# LUNA_COHOST_CREATOR_CHAT=1   # Viktor may answer creator panel/voice too (needs LUNA_COHOST_CHAT_PERSONAS=1)
# Dismiss = Luna solo until Summon; idle banter won't bring Viktor back (state: data/cohost_scene_state.json)
# LUNA_OLLAMA_TEMPERATURE=0.85
# LUNA_CHAT_MEMORY_RESET=1   # one-time: clear chat_memory.json on startup

# Optional extra channels Luna may listen and reply in (no TTS).
# TWITCH_EXTRA_IRC_CHANNELS=other_channel
# TWITCH_EXTRA_IRC_REPLY_COOLDOWN_SEC=30

# ── Vampire co-host (idle banter with Luna) ─────────────────────────────────
# LUNA_COHOST_BANTER=1
# LUNA_COHOST_NAME=Viktor
# LUNA_COHOST_EDGE_VOICE=en-US-BrianMultilingualNeural
# LUNA_COHOST_IDLE_SEC=90
# LUNA_COHOST_MIN_GAP_SEC=10
# LUNA_COHOST_POLL_SEC=30
# LUNA_COHOST_EXCHANGE_LINES=4
# Open-ended “full conversation” banter: model decides length; parsed lines are capped for safety.
# LUNA_COHOST_FULL_BANTER_MAX_LINES=72
# Legacy alias for the cap above if FULL_BANTER_MAX_LINES is unset:
# LUNA_COHOST_EXCHANGE_LINES_FULL=72
# LUNA_COHOST_CHAT_PERSONAS=1   # default on — Viktor can answer Twitch when chat says his name
# LUNA_COHOST_CHAT_SPEAKER=random   # random | luna | cohost | alternate (direct @Viktor always → Viktor)
# LUNA_COHOST_CHAT_ALIASES=vik,chriss   # extra names that count as addressing the co-host
# LUNA_COHOST_CHAT_TWITCH_PREFIX=1
# LUNA_COHOST_DYNAMICS=1
# LUNA_COHOST_DYNAMICS_LLM_EVERY=10
# LUNA_COHOST_DYNAMICS_FILE=data/cohost_dynamics.json
# LUNA_COHOST_EXPRESSIONS_DIR=D:/Luna streamer/expressions1
# LUNA_COHOST_IDLE_SKIP_SEC=2   # skip first N seconds of Viktor VRMA idles (bind/T-pose at start)

# ── Chat memory ──────────────────────────────────────────────────────────────
LUNA_CHAT_MEMORY_TURNS=10
LUNA_CHAT_MEMORY_MAX_CHARS=5000

# ── Ollama (local LLM) ───────────────────────────────────────────────────────
# Make sure `ollama serve` is running and the model below is pulled:
#   ollama pull qwen3.5:4b
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_VISION_MODEL=qwen3.5:4b
OLLAMA_MODEL_SMALL=qwen3.5:4b
OLLAMA_FALLBACK_MODEL=qwen3.5:4b
# Max GPU layer offload from this app's chat/vision calls (999999 = all layers on GPU,
# 0 = CPU only, or any integer for a fixed number of GPU layers).
LUNA_OLLAMA_NUM_GPU=999999
# Cap generation length so reasoning-tuned models (qwen3, deepseek-r1, …) can't
# spend 30s rambling on a one-line prompt. 0 / -1 = unlimited.
LUNA_OLLAMA_NUM_PREDICT=300
# Disable hidden chain-of-thought on reasoning models. Default false = no <think>
# block, straight to the visible answer. Set to true to re-enable thinking.
LUNA_OLLAMA_THINK=false
# Keep the model resident in VRAM between requests (avoid model-reload latency).
LUNA_OLLAMA_KEEP_ALIVE=30m
# Coalesce streamed tokens before pushing to the viewer. Lower = snappier feel,
# higher = fewer WS frames + less React churn. 50 ms / 48 chars are a good balance.
LUNA_STREAM_FLUSH_MS=50
LUNA_STREAM_FLUSH_CHARS=48

# ── Speech to text ───────────────────────────────────────────────────────────
# faster-whisper auto-picks cuda+float16 if available, else cpu+int8.
# Override with LUNA_STT_LOCAL_DEVICE=cpu or LUNA_STT_LOCAL_COMPUTE=int8 if needed.
# Skip language auto-detect (saves ~150 ms on tiny model); set to "auto" if needed.
LUNA_STT_LANGUAGE=en
# 1 = fastest beam (greedy decode); raise to 3-5 for slightly better accuracy on long clips.
LUNA_STT_BEAM_SIZE=1

# Optional Groq Whisper API (used only if local STT fails to initialize).
# GROQ_API_KEY=
# GROQ_STT_MODEL=whisper-large-v3
# GROQ_STT_LANGUAGE=en

# ── Microphone gating ────────────────────────────────────────────────────────
# Speaker verification: only the enrolled voice gets transcribed (recommended).
# Click "Enroll my voice" in the viewer once, then this gate activates.
LUNA_SPEAKER_ONLY=1
# LUNA_SPEAKER_MIN_SIM=0.75

# Old coarse pitch gate (only used if speaker gate is off):
# LUNA_VOICE_GATE_MALE_ONLY=1

# ── Luna TTS (Edge-TTS by default; Chatterbox optional) ──────────────────────
LUNA_TTS=1
LUNA_TTS_PLAY=0
# local = PC speakers (default). viewer = audio in the VRM browser (best for OBS window/browser source).
# LUNA_TTS_PLAY_TARGET=viewer
LUNA_TTS_BACKEND=edge
LUNA_TTS_MAX_CHARS=400
LUNA_EDGE_VOICE=en-US-AvaMultilingualNeural
LUNA_EDGE_RATE=+0%
LUNA_EDGE_PITCH=+0Hz
LUNA_TTS_VOICES=en-US-AvaMultilingualNeural:Ava,en-US-JennyNeural:Jenny,en-US-AriaNeural:Aria,en-US-GuyNeural:Guy,en-GB-SoniaNeural:Sonia
# Seconds after Luna's local TTS ends before the bridge accepts viewer mic audio (echo guard).
LUNA_VIEWER_VOICE_BLOCK_AFTER_TTS_SEC=3

# ── Screen share context (viewer dock → Luna vision) ─────────────────────────
# Viewer uploads ~1 JPEG/sec (see viewer/.env VITE_SCREEN_*). Bot summarizes every N sec.
# LUNA_SCREEN_CONTEXT=1
# LUNA_SCREEN_CONTEXT_INTERVAL_SEC=15
# LUNA_SCREEN_VISION_MODEL=gemma4:e4b
# LUNA_SCREEN_CONTEXT_MAX_CHARS=1200

# Chatterbox voice clone (only if LUNA_TTS_BACKEND=chatterbox). Point to a
# 5–15s WAV of the target voice. Local file, NOT committed to the repo.
# LUNA_CHATTERBOX_DEVICE=cpu
# LUNA_CHATTERBOX_VOICE_REF=D:/path/to/your_voice_reference.wav

# ── YouTube ──────────────────────────────────────────────────────────────────
# Channel ID for new-upload announcements (the UC… string after /channel/ on YouTube).
LUNA_YOUTUBE_CHANNEL_ID=
LUNA_YOUTUBE_POLL_SEC=300
# Optional: watch several channels for *today's* uploads (overrides single LUNA_YOUTUBE_CHANNEL_ID poller when set).
# Comma or space separated @handles, full channel URLs, UC… ids, or a channel Videos tab URL
# (``/videos?...`` with sort/shelf) so Luna polls that tab order via yt-dlp, not RSS order alone.
# Example tab: https://www.youtube.com/@Solonaras1/videos?view=0&sort=dd&shelf_id=4
# LUNA_YOUTUBE_OBSERVE_CHANNELS=https://www.youtube.com/@SomeChannel https://www.youtube.com/@OtherChannel
# LUNA_YOUTUBE_ANNOUNCE_DISCORD_CHANNEL_ID=1234567890123456789
# LUNA_YOUTUBE_OBSERVE_TODAY_ONLY=1
# YouTube Live chat: Luna reads chat with pytchat (pip install pytchat).
# Replies appear in the viewer / TTS only — never posted back to YouTube chat.
# LUNA_YOUTUBE_LIVE_CHAT=1
# LUNA_YOUTUBE_LIVE_CHECK_URL=https://www.youtube.com/@Solonaras1/live   # single URL for dock “check live”
# LUNA_YOUTUBE_LIVE_URL=https://www.youtube.com/watch?v=YOUR_LIVE_VIDEO_ID  # optional; viewer prompts if blank
# LUNA_YOUTUBE_LIVE_AUTO_REPLY=1
# LUNA_YOUTUBE_LIVE_AUTO_TRIGGER=all
# LUNA_YOUTUBE_LIVE_POLL_SEC=0.5
# LUNA_YOUTUBE_LIVE_WATCH_POLL=1          # background probe (same as dock button); default on when live chat is on
# LUNA_YOUTUBE_LIVE_WATCH_POLL_SEC=900     # every 15 minutes — auto-connects pytchat when live
# LUNA_YOUTUBE_LIVE_RECONNECT=1            # restart pytchat when the session drops mid-stream
# LUNA_YOUTUBE_LIVE_RECONNECT_DELAY_SEC=5
#
# Social (Playwright): optional profile URLs for the dock **key** login (defaults: X/Facebook login pages).
# LUNA_SOCIAL_X_LOGIN_START_URL=https://x.com/YourHandle
# LUNA_SOCIAL_FACEBOOK_LOGIN_START_URL=https://www.facebook.com/yourprofile
# LUNA_SOCIAL_FACEBOOK_POST_START_URL=https://www.facebook.com/yourprofile  # optional; defaults to LOGIN URL then facebook.com
# LUNA_SOCIAL_FACEBOOK_POST_COMMENT_PREFIX=Just posted:   # optional; skips LLM when set
# LUNA_SOCIAL_FACEBOOK_POST_COMMENT_TEMPLATE=Watch this: {title}   # optional; overrides LLM/prefix
# LUNA_SOCIAL_FACEBOOK_POST_COMMENT_LLM=1   # default on (uses OLLAMA_MODEL / LUNA_CHAT_MODEL + TWITCH_SYSTEM)
# LUNA_SOCIAL_FACEBOOK_POST_COMMENT_PROMPT=Write a hype post for my new video "{title}". No URL.
# LUNA_SOCIAL_FACEBOOK_POST_COMMENT_NUM_PREDICT=120
# LUNA_SOCIAL_FACEBOOK_POST_LEGACY_SHARER=1   # optional: sharer.php only (skip profile “What’s on your mind” flow)
# LUNA_SOCIAL_PLAYWRIGHT=1
# LUNA_SOCIAL_LIVE_SHARE=1                 # post to X/Facebook when you go live on YouTube or Twitch
# LUNA_SOCIAL_LIVE_POLL_SEC=90
# LUNA_SOCIAL_LIVE_TITLE_PREFIX=Live now:
# LUNA_SOCIAL_LIVE_YOUTUBE_URLS=https://www.youtube.com/@YourChannel/live
# LUNA_TWITCH_LIVE_ANNOUNCE=1                # detect Twitch go-live → Discord (all servers) + X/Facebook
# LUNA_TWITCH_LIVE_DISCORD=1                 # default on when ANNOUNCE=1
# LUNA_TWITCH_LIVE_SOCIAL=1                  # default on when ANNOUNCE=1 (needs LUNA_SOCIAL_PLAYWRIGHT + storage states)
# LUNA_TWITCH_LIVE_DISCORD_MESSAGE=🔴 **Live now on Twitch!**\n{title}\n\nJoin here: {url}
# DISCORD_LIVE_ANNOUNCE_CHANNEL_ID=         # optional fixed channel per guild lookup (else system/first writable)
# LUNA_SOCIAL_X_STORAGE_STATE=D:/path/luna_x.json
# LUNA_SOCIAL_X_POST_LEGACY_INTENT=1            # optional: intent URL only (skip sidebar compose UI)
# LUNA_SOCIAL_X_POST_START_URL=https://x.com/home
# LUNA_SOCIAL_X_INTENT_PATH=post              # post = x.com/intent/post (modal); tweet = legacy intent/tweet
# LUNA_SOCIAL_FACEBOOK_STORAGE_STATE=D:/path/luna_fb.json
# Luna's YouTube account — post real comments on videos (!explain / dock YouTube icon):
# LUNA_SOCIAL_YOUTUBE_STORAGE_STATE=D:/Luna streamer/data/luna_youtube.json
# LUNA_SOCIAL_YOUTUBE_COMMENT=1
# LUNA_YT_COMMENT_USE_STREAM_REPLY=1   # post Luna's on-stream reaction as the YouTube comment (else separate LLM line)
# LUNA_SOCIAL_PLAYWRIGHT_SHOW_BROWSER=1  # watch Chrome post the comment (debug)
# LUNA_SOCIAL_YOUTUBE_LOGIN_START_URL=https://www.youtube.com
# LUNA_SOCIAL_YOUTUBE_COMMENT_PROMPT=React briefly to "{title}" as Luna. No URL. Transcript:\n{transcript}
# LUNA_SOCIAL_PLAYWRIGHT_HEADLESS=1
# LUNA_SOCIAL_PLAYWRIGHT_SHOW_BROWSER=1    # always show Chrome for shares (overrides HEADLESS; watch steps)
# LUNA_SOCIAL_PLAYWRIGHT_SLOW_MO=200         # slow Playwright actions for debugging
# LUNA_SOCIAL_PLAYWRIGHT_CHANNEL=chrome
# LUNA_SOCIAL_CHROME_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
# Persistent Chrome profile for key-icon / CLI login (helps Google OAuth on X). Override root:
# LUNA_SOCIAL_INTERACTIVE_PROFILE_ROOT=D:/Luna streamer/data/social_chrome_profiles
# LUNA_SOCIAL_INTERACTIVE_EPHEMERAL=1            # revert to one-off temp profile (not recommended)
# LUNA_SOCIAL_INTERACTIVE_USE_SYNTHETIC_UA=1    # force built-in UA string instead of browser default
# Google blocks “Sign in with Google” in Playwright-launched Chrome — use X password, or CDP to your own Chrome:
# LUNA_SOCIAL_INTERACTIVE_CDP_URL=http://127.0.0.1:9222
# Then start Chrome (close other Chrome windows first, or use a dedicated --user-data-dir):
# "C:\Program Files\Google\Chrome\Application\chrome.exe" --remote-debugging-port=9222
# Viewer: key icon = interactive login; share icon = post a YouTube URL.

# !play / !explain (yt-dlp based).
LUNA_YT_DOWNLOAD=1
# LUNA_YT_DOWNLOAD_DIR=D:/path/to/yt_audio
LUNA_YT_TRANSCRIPT_MAX_CHARS=4000
# When YouTube has no captions: Qwen vision (see) + Whisper (hear), merged for !explain / comments.
# LUNA_YT_VISION_FALLBACK=1
# LUNA_YT_WHISPER_FALLBACK=1
# LUNA_YT_COMBINE_VISION_WHISPER=1
# LUNA_YT_VISION_MODEL=qwen3.5:4b
# LUNA_YT_VISION_MAX_SEC=120
# LUNA_YT_VISION_FRAMES=4
# LUNA_YT_WHISPER_MAX_SEC=480
# LUNA_YT_PLAYER_CLIENTS=android,web,ios,tv,mweb
